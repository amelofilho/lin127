#!/usr/bin/env python3
"""
Student submission script for assignments.
Usage: python submit.py <assignment_id>
"""

import sys
import os
import requests
import json
import subprocess

# Configuration
SERVER_URL = "https://robvoigt.net/lin127/submit"
if not os.path.exists('identity.txt'):
    print(f"Error: Identity file not found in 'identity.txt'")
    print("Please create this file as described in A1.")
    sys.exit(1)

try:
    NAME, EMAIL, SECRET_WORD = open('identity.txt').read().strip().split(',')
except:
    print(f"Error: Identity file couldn't be loaded properly.")
    print("Please create this file as described in A1.")
    sys.exit(1)

def submit_assignment(assignment_id):
    """
    Submit assignment to server. First runs locally, saving output, then uploads both main/code and output.
    """
    
    main_files = {'a1': 'a1.txt',
                 'a2': 'a2.sh',
                 'a3': 'a3.py',
                 'a4': 'a4.py',
                 'a5': 'a5.ipynb',
                 'a6': 'a6.ipynb'}

    if not assignment_id in main_files:
        print(f"Error: Assignment ID must be one of a1, a2, a3, a4, a5, or a6. You entered {assignment_id} - try again.")
        return False

    main_file = os.path.join(assignment_id, main_files[assignment_id])
    # Validate main file exists
    if not os.path.exists(main_file):
        print(f"Error: Main file '{main_file}' not found")
        return False
    
    # Prepare files
    files = {
        'main': open(main_file, 'rb')
    }

    test_results_file = os.path.join(assignment_id, f"{assignment_id}_out.txt")
    if assignment_id == 'a1':
        test_results_file = 'a1/contents'
        if not os.path.exists(test_results_file):
            print(f"Error: Not seeing 'contents' file in a1 directory (exercise 8.i) - carefully read the instructions and try again.")
            return False
    elif assignment_id == 'a2':
        result = subprocess.run(
            ['bash', 'a2.sh'],
            capture_output=True,
            text=True,
            cwd="a2"            
        )

        # Write stdout to file
        with open('a2/output.txt', 'w') as f:
            f.write(result.stdout)
        test_results_file = 'a2/output.txt'
    else:
        print(f"Error: Outdated submission script for Assignments 3+, please download a new one by running `wget robvoigt.net/lin127/submit.py`")
        return False
    
        
    if test_results_file and os.path.exists(test_results_file):
        files['results'] = open(test_results_file, 'rb')
    
    # Prepare form data
    data = {
        'assignment': assignment_id,
        'student': EMAIL,
        'secret_word': SECRET_WORD
    }
    
    print(f"Submitting {assignment_id}...")
    print(f"Main file: {main_file}")
    print(f"Results file: {test_results_file}")

    try:
        response = requests.post(
            SERVER_URL,
            files=files,
            data=data,
            timeout=30
        )
        print(response)
        
        # Close file handles
        for f in files.values():
            f.close()
        
        if response.status_code == 200:
            result = response.json()
            print("\n✓ Submission successful!")
            print(f"  Assignment: {assignment_id}")
            print(f"  Student: {result.get('student')}")
            print(f"  Time: {result.get('submission_time')}")
            print(f"  Message: {result.get('message')}")

            print("\nRemember that a successful submission just means the file transferred; it does not guarantee correctness.")
            return True
        else:
            error = response.json().get('error', 'Unknown error')
            print(f"\n✗ Submission failed: {error}")
            return False
            
    except requests.exceptions.RequestException as e:
        print(f"\n✗ Connection error: {e}")
        return False

def main():
    if len(sys.argv) < 2:
        print("Usage: python submit.py <assignment_id>")
        print("\nExample:")
        print("  python submit.py a1")
        sys.exit(1)
    
    assignment_id = sys.argv[1].strip('/').lower()
    
    success = submit_assignment(assignment_id)
    sys.exit(0 if success else 1)

if __name__ == "__main__":
    main()
